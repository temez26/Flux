# Host port Flux listens on
FLUX_PORT=8080

# UDP port two devices use to find each other for a direct transfer. Set to 0 to turn it
# off; direct transfers then only work on networks that resolve mDNS between devices.
FLUX_STUN_PORT=3478

# Database password. Only takes effect when the database volume is first created.
POSTGRES_PASSWORD=change-me

# Log level: error, warn, info, debug
RUST_LOG=info
